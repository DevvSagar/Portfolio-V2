# ==========================================
# SMTP Mail Configuration (Template)
# ==========================================
# Copy this file to .env and fill in your SMTP credentials.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_sender_email@gmail.com
SMTP_PASS=your_16_char_app_password

# The email where all contact messages will be delivered
CONTACT_RECIPIENT_EMAIL=deevvxxx@gmail.com
